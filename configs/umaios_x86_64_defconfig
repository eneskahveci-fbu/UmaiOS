# UmaiOS - lightweight, browser-bootable Linux (x86_64)
BR2_x86_64=y

# musl libc: smaller and faster to build than glibc, keeps the whole
# system lightweight.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# Match the toolchain's kernel headers to the kernel version below
# (needed by, among others, iproute2).
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# Branding
BR2_TARGET_GENERIC_HOSTNAME="umaios"
BR2_TARGET_GENERIC_ISSUE="Welcome to UmaiOS"
BR2_TARGET_GENERIC_ROOT_PASSWD="umaios"

# Paths into this BR2_EXTERNAL tree must be absolute: Buildroot resolves
# relative paths against its own source directory, not against ours.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_UMAIOS_PATH)/board/umaios/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_UMAIOS_PATH)/board/umaios/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_UMAIOS_PATH)/board/umaios/post-image.sh"

# Bring up networking automatically via DHCP on the first NIC.
BR2_SYSTEM_DHCP="eth0"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_UMAIOS_PATH)/board/umaios/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_BZIMAGE=y

# Root filesystem images:
#  - CPIO (gzip): initramfs used for the browser (v86) boot path and
#    for instant QEMU testing without a disk.
#  - EXT4: installable disk image for real hardware / VMs.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set

# Packages: kept deliberately small.
#  - dropbear: lightweight SSH server, for real remote/server use.
#  - nano: minimal text editor.
#  - htop: process monitor.
#  - iproute2: modern network diagnostics (ip, ss).
#  - ca-certificates: TLS trust store for wget/curl-style downloads.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_CA_CERTIFICATES=y
