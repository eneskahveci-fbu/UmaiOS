# UmaiOS kernel config fragment.
#
# Base hardware support is modeled on Buildroot's qemu_x86_64 reference
# board (works well under QEMU, most hypervisors and v86's PC emulation),
# trimmed of sound/3D-GPU drivers that a headless, serial-console-first
# lightweight OS doesn't need.

CONFIG_SYSVIPC=y
CONFIG_CGROUPS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_WIRELESS is not set

CONFIG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Boot from an initramfs (used for the browser/v86 boot path and for
# quick QEMU testing without a disk image).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Storage (used for the installable ext4/ISO disk image on real
# hardware/VMs; unused when booting straight from the initramfs).
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

# Networking hardware: virtio (modern VMs/cloud), NE2000 and RTL8139
# (widely emulated legacy NICs, including v86's virtual NIC).
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_NE2K_PCI=y
CONFIG_8139CP=y
# CONFIG_WLAN is not set

CONFIG_INPUT_EVDEV=y

# Serial console is the primary console for UmaiOS: it works
# identically under QEMU, v86 in the browser, and most VM consoles.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=m

# Plain VGA text console as a fallback on real hardware (no DRM/3D,
# no sound: keeps the kernel small).
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

CONFIG_EXT4_FS=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UNWINDER_FRAME_POINTER=y
